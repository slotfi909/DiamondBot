BOT_TOKEN=replace-with-a-development-bot-token

# Local-only credentials from docker-compose.dev.yml; never use in production.
DB=diamond
DB_USER=admin
DB_PASS=admin
DB_HOST=localhost
DB_PORT=6000
MODE=development

DATABASE_URL="postgresql://${DB_USER}:${DB_PASS}@${DB_HOST}:${DB_PORT}/${DB}"

ZARINPAL_MERCHANT_ID=
# Hostname only, without a scheme, port, or path. Required in production.
WEBHOOK_HOST=bot.example.com
WEBHOOK_PORT=8443

# Optional legacy payment-link configuration; not used by the main bot.
ZARINLINK_PHONE_NUMBER=
ZARINLINK_PAYMENT_LINK=
ZARINLINK_PAYMENTS_URL=
